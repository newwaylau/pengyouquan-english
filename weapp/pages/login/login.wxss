/**
 * 英语剧场 — 微信登录页样式
 */
.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.login-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #999;
}

.login-btn-area {
  margin-top: 40rpx;
}

.login-info {
  text-align: center;
  margin-top: 20rpx;
}

.login-hint {
  font-size: 24rpx;
  color: #bbb;
}

.logged-in {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}
