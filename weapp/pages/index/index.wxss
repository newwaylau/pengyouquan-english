/**
 * 英语剧场 — 首页练习样式
 */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  font-size: 36rpx;
  padding: 10rpx;
}

.search-results {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  max-height: 400rpx;
  overflow-y: auto;
}

.search-result-item {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-en {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.search-show {
  font-size: 22rpx;
  color: #999;
}

/* 头部 */
.practice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.show-name {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
}

.progress {
  font-size: 24rpx;
  color: #999;
}

/* 练习区 */
.practice-area {
  margin-top: 10rpx;
}

/* 句子详情 */
.sentence-detail {
  margin-bottom: 20rpx;
}

.sentence-id {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.chinese-text {
  font-size: 36rpx;
  color: #555;
  line-height: 1.6;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

/* 英文 */
.english-text {
  font-size: 32rpx;
  color: #667eea;
  padding: 20rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* 逐词输入 */
.word-input-area {
  margin-bottom: 20rpx;
}

.word-inputs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.word-input-wrapper {
  position: relative;
  display: inline-flex;
}

.word-input-wrapper .word-input {
  width: 120rpx;
  height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 8rpx;
  background: #fff;
}

.word-input-wrapper.correct .word-input {
  border-color: #52c41a;
  background: #f6ffed;
  color: #52c41a;
}

.word-input-wrapper.wrong .word-input {
  border-color: #ff4d4f;
  background: #fff2f0;
  color: #ff4d4f;
}

.word-input-wrapper.revealed .word-input {
  border-color: #faad14;
  background: #fffbe6;
  color: #faad14;
  font-weight: 600;
}

/* 反馈 */
.feedback {
  text-align: center;
  margin-bottom: 20rpx;
}

.feedback-text {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.feedback-text.correct {
  color: #52c41a;
  background: #f6ffed;
}

.feedback-text.wrong {
  color: #ff4d4f;
  background: #fff2f0;
}

.feedback-text.info {
  color: #faad14;
  background: #fffbe6;
}

/* 提交按钮 */
.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-bottom: 20rpx;
  border: none;
}

.btn-submit.submit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-submit.retry {
  background: linear-gradient(135deg, #faad14 0%, #f56c6c 100%);
  color: #fff;
}

.btn-submit.next {
  background: linear-gradient(135deg, #52c41a 0%, #36a15e 100%);
  color: #fff;
}

.btn-submit[disabled] {
  opacity: 0.5;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 36rpx;
  border: 2rpx solid #e0e0e0;
  color: #999;
  background: #fafafa;
}

.action-btn.active {
  border-color: #667eea;
  color: #667eea;
  background: #f0f4ff;
}

.action-btn:active {
  opacity: 0.7;
}

/* 快捷键提示 */
.shortcut-hint {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 10rpx;
}
