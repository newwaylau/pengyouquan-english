/**
 * 朋友圈英语 — 设置页样式
 */
.setting-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.pill-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pill {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid #e0e0e0;
  color: #666;
  background: #fafafa;
  text-align: center;
}

.pill.active {
  border-color: #667eea;
  color: #667eea;
  background: #f0f4ff;
}

.pill:active {
  opacity: 0.7;
}

.voice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.voice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  background: #fafafa;
}

.voice-item.active {
  border-color: #667eea;
  background: #f0f4ff;
}

.voice-item:active {
  opacity: 0.7;
}

.voice-name {
  font-size: 28rpx;
  color: #333;
}

.voice-check {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 700;
}

.about-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.about-item {
  font-size: 26rpx;
  color: #999;
}
