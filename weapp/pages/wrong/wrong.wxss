/**
 * 英语剧场 — 错题本页样式
 */
.wrong-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  padding: 8rpx 24rpx;
  border: 2rpx solid #ff4d4f;
  border-radius: 30rpx;
  background: #fff;
}

.clear-btn:active {
  background: #fff2f0;
}

.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wrong-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border-left: 6rpx solid #ff4d4f;
}

.wrong-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wrong-en {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.wrong-meta {
  font-size: 22rpx;
  color: #999;
}

.remove-btn {
  font-size: 32rpx;
  color: #ccc;
  padding: 8rpx;
}

.remove-btn:active {
  color: #ff4d4f;
}
