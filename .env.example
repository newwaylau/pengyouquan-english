# ====================================
# 朋友圈英语 — 环境变量配置示例
# 复制此文件为 docker/.env 并按需修改
# 注意：此文件不用于 docker-compose 环境变量替换，
#       仅作为 docker/.env 的参考模板
# ====================================

# --- MySQL 数据库配置 ---
MYSQL_ROOT_PASSWORD=pengyouquan123          # MySQL root 密码（生产环境请修改为强密码）
MYSQL_DATABASE=pengyouquan_english           # 数据库名

# --- Spring Boot 数据源配置 ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/pengyouquan_english?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root               # 数据库用户名
SPRING_DATASOURCE_PASSWORD=pengyouquan123     # 数据库密码（与 MYSQL_ROOT_PASSWORD 保持一致）

# --- Redis 配置 ---
SPRING_DATA_REDIS_HOST=redis                  # Redis 主机名（docker-compose 内部使用服务名）
SPRING_DATA_REDIS_PORT=6379                   # Redis 端口
SPRING_DATA_REDIS_TIMEOUT=2000ms              # Redis 连接超时

# --- JWT 密钥配置 ---
JWT_SECRET=pengyouquan-english-jwt-secret-key-2024-change-in-production
JWT_EXPIRATION=86400000                       # JWT 过期时间（毫秒，默认24小时）

# --- 微信小程序配置（可选）---
WECHAT_APP_ID=                                # 微信小程序 AppID（从微信公众平台获取）
WECHAT_APP_SECRET=                            # 微信小程序 AppSecret

# --- 日志配置 ---
LOGGING_LEVEL_COM_PENGYOUQUAN_ENGLISH=DEBUG   # 应用日志级别：DEBUG/INFO/WARN/ERROR

# --- Docker 部署相关 ---
COMPOSE_PROJECT_NAME=pengyouquan              # Docker Compose 项目名称
BACKEND_PORT=8080                             # 后端映射端口
FRONTEND_PORT=3000                            # 前端映射端口
MYSQL_PORT=3306                               # MySQL 映射端口
REDIS_PORT=6379                               # Redis 映射端口
